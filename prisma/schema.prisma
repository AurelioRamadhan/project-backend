generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PM
  INTERNAL
  CLIENT
}

enum Department {
  PRODUCT
  UIUX
  FRONTEND
  BACKEND
  CLIENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  department   Department
  deletedAt    DateTime?

  memberships    ProjectMember[]
  assignedTasks  Task[]          @relation("TaskAssignee")
  createdTasks   Task[]          @relation("TaskCreator")
  auditLogs      AuditLog[]      @relation("AuditActor")
  clientProjects Project[]       @relation("ProjectClient")
  attachments    Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  startDate   DateTime?
  dueDate     DateTime?
  clientId    String?
  client      User?    @relation("ProjectClient", fields: [clientId], references: [id])
  deletedAt   DateTime?

  members ProjectMember[]
  tasks   Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  deletedAt DateTime?

  @@unique([projectId, userId])
}

model Task {
  id              String     @id @default(uuid())
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        String     @default("MEDIUM")
  isClientVisible Boolean    @default(false)
  version         Int        @default(0)
  startDate       DateTime?
  dueDate         DateTime?
  department      Department
  deletedAt       DateTime?

  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  assigneeId  String?
  assignee    User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String
  createdBy   User    @relation("TaskCreator", fields: [createdById], references: [id])

  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents   TaskDependency[] @relation("TaskDependents")
  auditLogs    AuditLog[]
  attachments  Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
}

model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  task            Task     @relation("TaskDependencies", fields: [taskId], references: [id])
  dependsOnTaskId String
  dependsOnTask   Task     @relation("TaskDependents", fields: [dependsOnTaskId], references: [id])
  deletedAt       DateTime?

  @@unique([taskId, dependsOnTaskId])
}

model Attachment {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  filename     String
  originalName String
  mimeType     String
  size         Int
  deletedAt    DateTime?

  createdAt DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id])
  actorId       String
  actor         User     @relation("AuditActor", fields: [actorId], references: [id])
  changedColumn String
  oldValue      String?
  newValue      String?
  timestamp     DateTime @default(now())

  @@index([taskId, timestamp])
}